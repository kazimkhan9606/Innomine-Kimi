# ==========================================
# INNOMINE BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# CORE SERVER CONFIGURATION
# ------------------------------------------
# Environment mode (development | production | test)
NODE_ENV=development

# Port the backend runs on
PORT=5000

# ------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------
# MongoDB connection string (Atlas or local)
# Example: mongodb+srv://<user>:<pass>@cluster0.mongodb.net/innomine?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------
# AUTHENTICATION & SECURITY (REQUIRED)
# ------------------------------------------
# Secret keys used to sign JWT tokens. Generate strong random strings.
# Example: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiration times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS allowed origin
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# RATE LIMITING
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------
# FILE UPLOADS (OPTIONAL)
# ------------------------------------------
UPLOAD_MAX_SIZE_MB=5

# Cloudinary configuration (Needed for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------
# EMAIL (OPTIONAL)
# ------------------------------------------
# SMTP Configuration for transactional emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
